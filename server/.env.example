# Copia este archivo como server/.env y completa los valores (no se sube a GitHub).
PORT=5000
# Local (Docker): mongodb://<usuario>:<contraseña>@localhost:27017/senacampus_db?authSource=admin
# Atlas (nube):   mongodb+srv://<usuario>:<contraseña>@<cluster>.mongodb.net/senacampus_db?retryWrites=true&w=majority
MONGO_URI=

# Identificación del usuario mientras no está Firebase: "desarrollo" permite usar el encabezado X-Usuario-Correo.
# NUNCA dejarlo en "desarrollo" en el servidor publicado.
AUTH_MODO=desarrollo

# Firebase Authentication: id del proyecto (no es secreto). Con esto el servidor verifica los inicios de sesión.
FIREBASE_PROJECT_ID=senacampus-f5683

# Voz natural en la nube para el Diálogo (opcional). Crea una cuenta gratis en elevenlabs.io,
# copia tu API key aquí. Sin clave, la app usa la voz del teléfono.
ELEVENLABS_API_KEY=
# Opcional: id de otra voz (Voice Library de ElevenLabs). Vacío = voz por defecto.
ELEVENLABS_VOZ_ID=
