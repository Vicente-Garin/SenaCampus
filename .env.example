# Copia este archivo como .env (en la raíz del repositorio) y completa los valores.
# El .env real está en .gitignore y nunca se sube a GitHub.

# Usuario administrador que crea Docker al iniciar MongoDB por primera vez
MONGO_ROOT_USER=
MONGO_ROOT_PASSWORD=

# Nombre de la base de datos del proyecto
MONGO_DB=senacampus_db

# Cadena de conexión que usan los scripts de database/ y el backend
# Formato: mongodb://<usuario>:<contraseña>@localhost:27017/<base>?authSource=admin
MONGO_URI=
